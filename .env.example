# ============================================
# MindfulAI — Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values.

# --- Hugging Face ---
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# LLM model for chat completions (must support text-generation)
HF_MODEL_ID=meta-llama/Meta-Llama-3-8B-Instruct

# Embedding model for vector search
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Pinecone ---
# Get your API key at: https://app.pinecone.io
PINECONE_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Name of your Pinecone index (must already exist with dimension=384)
PINECONE_INDEX_NAME=mental-health-chatbot

# --- App ---
NEXT_PUBLIC_APP_NAME=MindfulAI
